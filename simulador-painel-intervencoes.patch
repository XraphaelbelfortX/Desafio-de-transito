+export const OESTE: Vec2 = { x: -1, y: 0 };
+export const NORTE: Vec2 = { x: 0, y: 1 };
+export const SUL: Vec2 = { x: 0, y: -1 };
+
+export const kmh = (v: number) => v / 3.6;
+export const paraKmh = (v: number) => v * 3.6;
