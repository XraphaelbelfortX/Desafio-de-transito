+  // travessias de pedestre cruzadas pela rota
+  for (const t of rede.travessias) {
+    const ped = elementos.get(`P:${t.id}:SN`);
+    if (!ped) continue;
+    for (const x of intersecoes(r.linha, ped.linha)) {
