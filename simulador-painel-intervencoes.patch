+  if (r.manobra) r.manobra.sRota = r.linha.projetar(r.manobra.ponto).s;
+  r.cedencias.sort((a, b) => a.sRota - b.sRota);
+  r.retencoes.sort((a, b) => a.sRota - b.sRota);
+  r.travessias.sort((a, b) => a.sRota - b.sRota);
